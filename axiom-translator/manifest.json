{
  "manifest_version": 3,
  "name": "Axiom Translator (RU)",
  "version": "1.1.0",
  "description": "Переводит сообщения пользователей (коллауты, посты, чат) на axiom.trade на русский язык.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://axiom.trade/*", "https://*.axiom.trade/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Axiom Translator",
    "default_popup": "popup.html"
  }
}
